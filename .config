#
# ImmortalWrt master — CMCC RAX3000Q / RAX3000QY (qualcommax/ipq50xx)
# Package set tuned for 256 MiB RAM: lean LuCI + user-selected services,
# WiFi enabled via device-tree patch (see diy-part2.sh / patches/).
#

# ---- Target & device ----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_cmcc_rax3000q=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_cmcc_rax3000q=y
CONFIG_TARGET_PROFILE="DEVICE_cmcc_rax3000q"

# ---- LuCI web interface ----
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# ---- User-selected services ----
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-upnp=y

# ---- Proxy: homeproxy (sing-box based, actively maintained, lean) ----
CONFIG_PACKAGE_luci-app-homeproxy=y

# ---- WiFi firmware & board data ----
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-cmcc_rax3000q=y

# ---- RAM optimization for 256 MiB ----
# zram compressed swap — the main OOM safety net for ath11k
CONFIG_PACKAGE_zram-swap=y
# Lean wpa stack instead of full wpad-openssl
# (DEFAULT_PACKAGES patched in diy-part2.sh: wpad-openssl -> wpad-basic-mbedtls)
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# ---- Performance ----
# TCP BBR congestion control + fq qdisc (enabled via files/etc/sysctl.d)
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---- Essential dial-up support (home broadband PPPoE) ----
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ---- IPv6 ----
CONFIG_PACKAGE_ip-full=y
